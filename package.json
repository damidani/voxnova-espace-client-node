  "description": "Espace client clé en main pour les revendeurs VoxNova : vos clients gèrent leur téléphonie sur votre site, à vos couleurs.",
  "license": "MIT",
  "author": "Damien B.",
  "type": "module",
  "main": "src/server.js",
