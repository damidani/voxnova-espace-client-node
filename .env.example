# Adresse de l'API de la plateforme
API_URL=https://api.hcloud.fr
# Votre clé d'API revendeur (panneau revendeur › API et documentation › Clés d'API). Ne la partagez jamais.
API_KEY=vxr_xxxxxxxxxxxxxxxxxxxxxxxx

# Votre marque
BRAND_NAME=Mon Opérateur
BRAND_COLOR=#4f46e5
BRAND_LOGO_URL=
SUPPORT_EMAIL=support@mon-operateur.fr
SUPPORT_PHONE=

# Adresse publique de cet espace client (liens des e-mails de réinitialisation du mot de passe)
PUBLIC_URL=https://espace.mon-operateur.fr
# Secret de signature des sessions : 32 caractères aléatoires au moins (openssl rand -hex 32)
SESSION_SECRET=
# Port d'écoute
PORT=3000
# Derrière un proxy (Nginx, Caddy, Cloudflare) : true pour lire l'adresse réelle des visiteurs
TRUST_PROXY=false
# Inscription en ligne de nouveaux clients (essai gratuit) : true ou false
ALLOW_SIGNUP=false
# Durée de l'essai à l'inscription (jours)
SIGNUP_TRIAL_DAYS=14
