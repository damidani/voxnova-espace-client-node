<div class="card">
  <h1>Mot de passe oublié</h1>
  <% if (typeof sent !== 'undefined' && sent) { %>
    <div class="alert success">Si un compte existe avec cette adresse, vous allez recevoir un e-mail avec un lien pour choisir un nouveau mot de passe (valable 1 heure).</div>
    <a class="btn ghost" href="/connexion">Retour à la connexion</a>
  <% } else { %>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/mot-de-passe-oublie">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="email">E-mail de votre compte</label>
      <input class="input" id="email" name="email" type="email" required autofocus>
      <button class="btn">Recevoir le lien</button>
    </form>
    <div class="links"><a href="/connexion">Retour à la connexion</a></div>
  <% } %>
</div>
